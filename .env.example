# Compose interpolation and private backend runtime settings. Never commit .env.
DB_NAME=ibfs_db
DB_USER=ibfs
DB_PASSWORD=replace-with-a-strong-database-password
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-ibfs-domain.example
CSRF_TRUSTED_ORIGINS=https://your-ibfs-domain.example
CORS_ALLOWED_ORIGINS=https://your-ibfs-domain.example
BACKEND_IMAGE=ibfs-backend:local
FRONTEND_IMAGE=ibfs-frontend:local
FRONTEND_BIND_ADDRESS=127.0.0.1
# For local `npm run dev`, set DJANGO_ORIGIN=http://127.0.0.1:8000 in .env.local.

# Shared across Gunicorn workers; startup creates the table automatically.
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=ibfs_cache

# App administrator: created or synchronized from these fields on every startup.
# Changing the password here updates this login; unchanged values preserve its hash.
# Leave all three blank to disable environment management. Backend runtime only.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Small-VM runtime defaults; increase workers only when memory allows.
WEB_CONCURRENCY=1
WEB_THREADS=2
GUNICORN_TIMEOUT=90

# Allow first-time migrations/static collection on shared-core VMs.
BACKEND_HEALTH_START_PERIOD=600s
